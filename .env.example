# Kairos ATS API (login, cadastro, modal "Analisar CV")
# Produção (Render): URL pública da API ATS — obrigatório no build.
# VITE_ATS_API_URL=https://sua-api-ats.onrender.com
#
# Dev local (:3355): deixe VITE_ATS_API_URL vazio ou comente a linha.
# O Vite faz proxy de /v1 → http://127.0.0.1:4000 (cookies de sessão funcionam).
# VITE_ATS_API_URL=

# Feature flag — botão "Analisar CV" nos cards.
# Em dev (import.meta.env.DEV) já vem ativo automaticamente.
# Em produção, defina "true" para ligar; qualquer outro valor mantém oculto.
# VITE_FEATURE_ATS_ANALYSIS=true
