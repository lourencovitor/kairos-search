# Kairos ATS API (login, cadastro, modal "Analisar CV")
# Produção (Render): URL pública da API ATS — obrigatório no build.
# VITE_ATS_API_URL=https://sua-api-ats.onrender.com
#
# Dev local (:3355): deixe VITE_ATS_API_URL vazio ou comente a linha.
# O Vite faz proxy de /v1 → http://127.0.0.1:4000 (cookies de sessão funcionam).
# VITE_ATS_API_URL=

# Feature flag — botão "Analisar CV" nos cards.
# Em dev (import.meta.env.DEV) já vem ativo automaticamente.
# Em produção, defina "true" para ligar; qualquer outro valor mantém oculto.
# VITE_FEATURE_ATS_ANALYSIS=true

# Feature flag — login, cadastro, RequireAuth na home e menu de perfil.
# VITE_FEATURE_AUTH=true

# ─── Google AdSense ──────────────────────────────────────────────────────────
# Quando estas 5 variáveis estão definidas no build de produção, os componentes
# de anúncio renderizam <ins class="adsbygoogle"> com os slots reais (no mesmo
# lugar que hoje mostram os placeholders Rocketseat/Copilot/AWS/Alura).
# Em dev (import.meta.env.DEV) ou sem essas envs, continua mostrando os mocks.
#
# Como obter cada slot ID:
#   1. AdSense → Anúncios → Por unidade de anúncio → Criar nova unidade
#   2. Tipo recomendado por slot (ver tabela abaixo) e copie o "data-ad-slot"
#      gerado (número de 10 dígitos).
#
# Tipos sugeridos:
#   leaderboard  → Banner / display          (topo do feed)
#   feed         → In-feed / in-article      (entre cards a cada 5 vagas)
#   sidebarTop   → Display retângulo         (sidebar direita, topo)
#   sidebarBot   → Display retângulo         (sidebar direita, abaixo)
#
# VITE_ADSENSE_CLIENT=ca-pub-9297079486621607
# VITE_AD_SLOT_LEADERBOARD=0000000001
# VITE_AD_SLOT_FEED=0000000002
# VITE_AD_SLOT_SIDEBAR_TOP=0000000003
# VITE_AD_SLOT_SIDEBAR_BOT=0000000004
