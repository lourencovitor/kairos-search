# Kairos ATS API (modal "Analisar CV" nos cards de vaga)
# Obrigatório no build de produção (Render: variável no painel antes do deploy).
# Local: API Docker ou pnpm dev:api em :4000
VITE_ATS_API_URL=http://localhost:4000

# Feature flag — botão "Analisar CV" nos cards.
# Em dev (import.meta.env.DEV) já vem ativo automaticamente.
# Em produção, defina "true" para ligar; qualquer outro valor mantém oculto.
# VITE_FEATURE_ATS_ANALYSIS=true
