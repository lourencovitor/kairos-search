# ── Server ────────────────────────────────────────────────────────────────────

# Port for the production/API server (default: 3355)
PORT=3355

# Port for the API server in dev mode (default: 3356)
API_PORT=3356

# Set to "true" to bind the server to 0.0.0.0 instead of 127.0.0.1
# Only set this when deploying behind a reverse proxy or in a container
KAIROS_LISTEN_ALL=false

# ── Security ───────────────────────────────────────────────────────────────────

# Bearer token for POST /api/run and download endpoints.
# Leave unset to allow unauthenticated access (not recommended for public deploys).
KAIROS_API_TOKEN=

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins (open by default).
# Example: KAIROS_ALLOWED_ORIGINS=https://kairos.app,http://localhost:3355
KAIROS_ALLOWED_ORIGINS=

# ── Runtime ────────────────────────────────────────────────────────────────────

# Set to "production" to serve the pre-built client and disable dev Vite server
NODE_ENV=development

# Set to "true" to disable Playwright/Browser MCP (useful for server-only deploys)
DISABLE_BROWSER=false

# ── Frontend (Vite VITE_* vars are inlined at build time) ────────────────────

# Google AdSense client ID — fill in after approval
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_AD_SLOT_LEADERBOARD=0000000001
# VITE_AD_SLOT_FEED=0000000002
# VITE_AD_SLOT_SIDEBAR_TOP=0000000003
# VITE_AD_SLOT_SIDEBAR_BOT=0000000004
