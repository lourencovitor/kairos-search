{
  "name": "job-search-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "build:prod": "pnpm build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test-fixtures",
    "lint:fix": "eslint src test-fixtures --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test-fixtures/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test-fixtures/**/*.ts\"",
    "job-research": "tsx src/job-research-agent/cli/run-job-research.ts",
    "job-web": "tsx src/job-research-agent/web/server.ts",
    "dev:web": "vite",
    "start": "tsx src/job-research-agent/web/server.ts",
    "start:prod": "NODE_ENV=production tsx src/job-research-agent/web/server.ts",
    "test": "vitest --run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.19.3",
    "vite": "^8.0.13"
  }
}
